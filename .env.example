# Porta HTTP utilizada pelo servidor.
PORT=8080

# Host exibido no log de inicialização.
PUBLIC_HOST=localhost

# Primeiro administrador. Usado apenas se ainda não houver usuários no banco.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Quantidade máxima de conversões simultâneas.
QUEUE_CONCURRENCY=1

# Dias antes da exclusão definitiva dos vídeos na lixeira.
TRASH_RETENTION_DAYS=30

# HTTPS opcional. Os dois arquivos precisam ser informados juntos.
TLS_CERT_FILE=
TLS_KEY_FILE=
